aws_region           = "ap-south-1"
environment          = "prod"
project_name         = "react-aws-website"

# Replace with your domain registered at BigRock
domain_name          = "example.com"

# Set to true for a brand new domain, or false if the Route 53 zone already exists and is delegated in BigRock
create_hosted_zone   = true

# Replace with your GitHub details for OIDC role configuration
github_org           = "your-github-username"
github_repo          = "your-repo-name"
github_branch        = "main"

# Set to false if an IAM OIDC provider for token.actions.githubusercontent.com already exists in your AWS account
create_oidc_provider = true

tags = {
  Environment = "prod"
  Project     = "portfolio-demo"
  Owner       = "Siddhesh"
}

